{
  "schemaVersion": 1,
  "id": "namnbtview",
  "version": "2.2.0",
  "name": "NamNBTview",
  "description": "Displays item and entity NBT (SNBT) directly in tooltips and overlays for Minecraft 26.1.2.",
  "authors": ["Nattapat2871"],
  "license": "MIT",
  "icon": "assets/nbtviewer/logo.png",
  "environment": "client",

  "entrypoints": {
    "client": ["org.hohigamer.nbtviewer.NbtviewerClient"],
    "modmenu": ["org.hohigamer.nbtviewer.client.NbtviewerModMenu"]
  },

  "mixins": ["nbtviewer.mixins.json"],

  "depends": {
    "minecraft": "26.1.2",
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "fabric-key-mapping-api-v1": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
