{
  "schemaVersion": 1,
  "id": "namnbtview",
  "version": "2.3.0",
  "name": "NamNBTview",
  "description": "Displays item and entity NBT (SNBT) directly in tooltips and overlays for Minecraft 1.21.11.",
  "authors": ["Nattapat2871"],
  "license": "MIT",
  "icon": "assets/nbtviewer/logo.png",
  "environment": "client",

  "entrypoints": {
    "client": ["org.hohigamer.nbtviewer.NbtviewerClient"],
    "modmenu": ["org.hohigamer.nbtviewer.client.NbtviewerModMenu"]
  },

  "mixins": ["nbtviewer.mixins.json"],

  "depends": {
    "minecraft": "1.21.11",
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
